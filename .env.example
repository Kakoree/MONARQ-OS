# Copy to .env.local for local development and fill in real values.
# In Vercel, set these under Project Settings → Environment Variables for
# both Production and Preview.

# Supabase project URL and publishable (anon) key — both safe to expose
# client-side, protected by RLS. Found in Supabase Dashboard → Project
# Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's own public URL, used for the magic-link sign-in redirect and
# metadataBase (lib/site-url.ts). Set this for Production only.
# Local dev: http://localhost:3000 (or leave unset — falls back to this)
# Production: your real deployed domain (e.g. https://your-app.vercel.app)
# Preview: leave unset — Preview deployments automatically fall back to
# Vercel's own per-deployment VERCEL_URL, which needs no configuration here.
# Setting NEXT_PUBLIC_SITE_URL on Preview would incorrectly point every
# preview at the production domain instead of its own unique URL.
NEXT_PUBLIC_SITE_URL=
