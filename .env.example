# Copy to .env.local for local development and fill in real values.
# In Vercel, set these under Project Settings → Environment Variables for
# both Production and Preview.

# Supabase project URL and publishable (anon) key — both safe to expose
# client-side, protected by RLS. Found in Supabase Dashboard → Project
# Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's own public URL, used for the admin password-reset redirect and
# metadataBase (lib/site-url.ts). Set this for Production only.
# Local dev: http://localhost:3000 (or leave unset — falls back to this)
# Production: your real deployed domain (e.g. https://your-app.vercel.app)
# Preview: leave unset — Preview deployments automatically fall back to
# Vercel's own per-deployment VERCEL_URL, which needs no configuration here.
# Setting NEXT_PUBLIC_SITE_URL on Preview would incorrectly point every
# preview at the production domain instead of its own unique URL.
NEXT_PUBLIC_SITE_URL=

# Transactional email (Resend). Free tier is sufficient at current scale.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- Scheduled nudges (V3 Phase 2) -----------------------------------------
# Both are REQUIRED in Vercel Production or the daily cron at
# /api/cron/nudges silently does nothing: without CRON_SECRET every
# invocation is rejected as unauthorized, and without the service-role key
# the scan cannot read across members.
#
# Service-role key bypasses RLS entirely — server-only, never expose it
# client-side and never prefix it with NEXT_PUBLIC_. Supabase Dashboard →
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; must match between Vercel and nothing else.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
