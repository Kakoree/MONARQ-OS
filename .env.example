# Copy to .env.local for local development and fill in real values.
# In Vercel, set these under Project Settings → Environment Variables for
# both Production and Preview.

# Supabase project URL and publishable (anon) key — both safe to expose
# client-side, protected by RLS. Found in Supabase Dashboard → Project
# Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The app's own public URL, used for the magic-link sign-in redirect.
# Local dev: http://localhost:3000
# Production: your real deployed domain (e.g. https://your-app.vercel.app)
# Note: Preview deployments each get a unique Vercel URL that won't match a
# single fixed value here — magic links won't round-trip correctly on
# Preview until this is addressed (see V1 hardening notes).
NEXT_PUBLIC_SITE_URL=
